fn greet(name: str) -> str {
    "Hello, " + name + "!"
}

let mut line = "";
let mut i = 0;
while i < 5 {
    line = line + "*";
    i = i + 1;
}
print(greet("Rock"));
print(line);

let word = "rocket";
print(word[..4]); // slices count bytes, not characters
print(word[4..] + word[1..3]);
print(bytes(word[..4]));
line == "*****"
