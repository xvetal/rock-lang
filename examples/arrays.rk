fn sum(xs: [int]) -> int {
    let mut total = 0;
    // `for x in xs` runs the body once for each element.
    for x in xs {
        total = total + x;
    }
    total
}

let grid = [[1, 2, 3], [4, 5, 6]];
print(grid);
print(sum(grid[1]));
print(grid[0] == [1, 2, 3]);
print(["a", "b, c"]);

let zeros = [0, 0, 0, 0];
let mut squares = zeros;
for i in 0..len(squares) {
    squares[i] = i * i;
}
print(squares);
print(squares[1..3]);
print(zeros); // arrays are values: squares was a copy

let mut words: [str] = [];
push(words, "rock");
push(words, "lang");
print(words);
