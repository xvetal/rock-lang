fn sum(xs: [int]) -> int {
    let mut total = 0;
    let mut i = 0;
    while i < len(xs) {
        total = total + xs[i];
        i = i + 1;
    }
    total
}

let grid = [[1, 2, 3], [4, 5, 6]];
print(grid);
print(sum(grid[1]));
print(grid[0] == [1, 2, 3]);
print(["a", "b, c"]);

let zeros = [0, 0, 0, 0];
let mut squares = zeros;
let mut i = 0;
while i < len(squares) {
    squares[i] = i * i;
    i = i + 1;
}
print(squares);
print(zeros);
